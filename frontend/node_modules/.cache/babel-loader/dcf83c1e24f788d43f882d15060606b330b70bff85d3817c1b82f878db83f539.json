{"ast":null,"code":"import ContentField from '@/components/ContentField.vue';\nexport default {\n  components: {\n    ContentField\n  }\n};","map":{"version":3,"names":["ContentField","components"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/calendar/CalendarIndexView.vue"],"sourcesContent":["<template>\n <div class=\"calendar-container\">\n    <!-- 左侧区域：普通日历列表 + 当日事件 -->\n    <div class=\"left-section\">\n      <div class=\"calendar-list\">\n        普通日历列表\n      </div>\n      <div class=\"daily-event\">\n        当日事件：\n      </div>\n    </div>\n\n    <!-- 右侧区域：备忘录 -->\n    <div class=\"right-section\">\n      备忘录\n    </div>\n  </div>\n</template>\n\n<script>   \nimport ContentField from '@/components/ContentField.vue'; \n\nexport default {\n    components: {\n        ContentField,\n    },\n}\n</script>\n\n<style scoped>  \n/* 父容器：Grid 布局（核心） */\n.calendar-container {\n  display: grid;\n  /* 定义列：左侧 2fr，右侧 1fr */\n  grid-template-columns: 2fr 1fr;\n  /* 定义行：单行 */\n  grid-template-rows: 1fr;\n  /* 列间距：20px */\n  gap: 20px;\n  /* 容器内边距 */\n  padding: 20px;\n  /* 占满父容器高度 */\n  height: calc(100vh - 60px);\n  box-sizing: border-box;\n}\n\n/* 左侧区域：垂直排列两个子模块 */\n.left-section {\n  display: grid;\n  /* 行：上方 1fr，下方 1fr */\n  grid-template-rows: 1fr 1fr;\n  /* 行间距：20px */\n  gap: 20px;\n  height: 100%;\n}\n\n/* 通用区块样式（统一边框、内边距、背景） */\n.calendar-list, .daily-event, .right-section {\n  border: 2px solid #000;\n  padding: 16px;\n  background-color: #f5f5f5;\n  font-size: 18px;\n  /* 内容居中（可选，根据需求调整） */\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n}\n\n/* 右侧单独占满高度 */\n.right-section {\n  height: 100%;\n}\n</style>"],"mappings":"AAoBA,OAAOA,YAAW,MAAO,+BAA+B;AAExD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}