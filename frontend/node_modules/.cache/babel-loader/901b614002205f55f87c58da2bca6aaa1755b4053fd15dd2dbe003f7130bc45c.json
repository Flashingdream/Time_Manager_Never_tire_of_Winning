{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport ContentField from '@/components/ContentField.vue';\n// 引入axios（请确保已安装：npm install axios）\nimport axios from 'axios';\n\n// 配置axios基础路径（和后端统一）\naxios.defaults.baseURL = 'http://localhost:8080/api'; // 替换为你的后端接口地址\n\nexport default {\n  name: 'CalendarIndexView',\n  components: {\n    ContentField\n  },\n  data() {\n    return {\n      // 选中的日期（核心：当日事件绑定此字段）\n      selectedDate: '',\n      // 当日事件列表（和后端数据结构一致）\n      dailyEvents: [],\n      // 备忘录列表（独立，不绑定日期）\n      memos: []\n    };\n  },\n  created() {\n    // 页面加载时：1. 默认选中今日 2. 获取今日事件 3. 获取所有备忘录\n    this.selectedDate = new Date().toISOString().split('T')[0]; // 格式：YYYY-MM-DD\n    this.getDailyEvents(); // 获取当日事件\n    this.getMemos(); // 获取备忘录\n  },\n  methods: {\n    /**\n     * 1. 获取当日事件（绑定选中日期）\n     * 后端接口建议：GET /daily-events?date=2026-04-08\n     */\n    async getDailyEvents() {\n      if (!this.selectedDate) return;\n      try {\n        const res = await axios.get('/daily-events', {\n          params: {\n            date: this.selectedDate\n          } // 携带日期参数，和后端绑定\n        });\n        // 后端返回格式建议：[{ id: 1, content: '事件1', date: '2026-04-08' }, ...]\n        this.dailyEvents = res.data.data || [];\n      } catch (error) {\n        console.error('获取当日事件失败：', error);\n        this.$message.error('获取事件失败，请重试');\n      }\n    },\n    /**\n     * 2. 删除当日事件\n     * 后端接口建议：DELETE /daily-events/{id}\n     */\n    async deleteDailyEvent(eventId) {\n      if (!eventId) return;\n      try {\n        await axios.delete(`/daily-events/${eventId}`);\n        // 前端实时更新：过滤掉删除的事件（无需重新请求，提升体验）\n        this.dailyEvents = this.dailyEvents.filter(item => item.id !== eventId);\n        this.$message.success('事件删除成功');\n      } catch (error) {\n        console.error('删除当日事件失败：', error);\n        this.$message.error('删除事件失败，请重试');\n      }\n    },\n    /**\n     * 3. 获取所有备忘录（独立，不携带日期）\n     * 后端接口建议：GET /memos\n     */\n    async getMemos() {\n      try {\n        const res = await axios.get('/memos');\n        // 后端返回格式建议：[{ id: 1, content: '备忘录1' }, ...]\n        this.memos = res.data.data || [];\n      } catch (error) {\n        console.error('获取备忘录失败：', error);\n        this.$message.error('获取备忘录失败，请重试');\n      }\n    },\n    /**\n     * 4. 删除备忘录\n     * 后端接口建议：DELETE /memos/{id}\n     */\n    async deleteMemo(memoId) {\n      if (!memoId) return;\n      try {\n        await axios.delete(`/memos/${memoId}`);\n        // 前端实时更新：过滤掉删除的备忘录\n        this.memos = this.memos.filter(item => item.id !== memoId);\n        this.$message.success('备忘录删除成功');\n      } catch (error) {\n        console.error('删除备忘录失败：', error);\n        this.$message.error('删除备忘录失败，请重试');\n      }\n    }\n  }\n};","map":{"version":3,"names":["ContentField","axios","defaults","baseURL","name","components","data","selectedDate","dailyEvents","memos","created","Date","toISOString","split","getDailyEvents","getMemos","methods","res","get","params","date","error","console","$message","deleteDailyEvent","eventId","delete","filter","item","id","success","deleteMemo","memoId"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/calendar/CalendarIndexView.vue"],"sourcesContent":["<template>\n  <div class=\"calendar-grid-container\">\n    <!-- 左侧区域：日历列表 + 当日事件 -->\n    <div class=\"calendar-left-section\">\n      <!-- 1. 普通日历列表（带日期选择） -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>普通日历列表</h5>\n          <!-- 日期选择器（核心：绑定选中日期） -->\n          <el-date-picker\n            v-model=\"selectedDate\"\n            type=\"date\"\n            placeholder=\"选择日期\"\n            @change=\"getDailyEvents\"\n            style=\"margin-bottom: 15px; width: 100%;\"\n          >\n          </el-date-picker>\n          <!-- 日历简单展示（可替换为具体日历组件） -->\n          <div class=\"calendar-tip\">当前选中：{{ selectedDate || '请选择日期' }}</div>\n        </div>\n      </ContentField>\n\n      <!-- 2. 当日事件（绑定选中日期，可删除） -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>当日事件：</h5>\n          <!-- 空状态提示 -->\n          <div v-if=\"dailyEvents.length === 0\" class=\"empty-tip\">暂无当日事件</div>\n          <!-- 事件列表：逐行展示 + 删除按钮 -->\n          <div v-else class=\"event-list\">\n            <div \n              v-for=\"(event, index) in dailyEvents\" \n              :key=\"event.id || index\" \n              class=\"event-item\"\n            >\n              <span class=\"event-text\">{{ event.content }}</span>\n              <el-button \n                type=\"text\" \n                icon=\"el-icon-delete\" \n                class=\"delete-btn\"\n                @click=\"deleteDailyEvent(event.id)\"\n              >\n                删除\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </ContentField>\n    </div>\n\n    <!-- 右侧区域：备忘录（独立，可删除） -->\n    <div class=\"calendar-right-section\">\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>备忘录：</h5>\n          <!-- 空状态提示 -->\n          <div v-if=\"memos.length === 0\" class=\"empty-tip\">暂无备忘录</div>\n          <!-- 备忘录列表：逐行展示 + 删除按钮 -->\n          <div v-else class=\"memo-list\">\n            <div \n              v-for=\"(memo, index) in memos\" \n              :key=\"memo.id || index\" \n              class=\"memo-item\"\n            >\n              <span class=\"memo-text\">{{ memo.content }}</span>\n              <el-button \n                type=\"text\" \n                icon=\"el-icon-delete\" \n                class=\"delete-btn\"\n                @click=\"deleteMemo(memo.id)\"\n              >\n                删除\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </ContentField>\n    </div>\n  </div>\n</template>\n\n<script>\nimport ContentField from '@/components/ContentField.vue';\n// 引入axios（请确保已安装：npm install axios）\nimport axios from 'axios';\n\n// 配置axios基础路径（和后端统一）\naxios.defaults.baseURL = 'http://localhost:8080/api'; // 替换为你的后端接口地址\n\nexport default {\n  name: 'CalendarIndexView',\n  components: {\n    ContentField\n  },\n  data() {\n    return {\n      // 选中的日期（核心：当日事件绑定此字段）\n      selectedDate: '',\n      // 当日事件列表（和后端数据结构一致）\n      dailyEvents: [],\n      // 备忘录列表（独立，不绑定日期）\n      memos: []\n    };\n  },\n  created() {\n    // 页面加载时：1. 默认选中今日 2. 获取今日事件 3. 获取所有备忘录\n    this.selectedDate = new Date().toISOString().split('T')[0]; // 格式：YYYY-MM-DD\n    this.getDailyEvents(); // 获取当日事件\n    this.getMemos(); // 获取备忘录\n  },\n  methods: {\n    /**\n     * 1. 获取当日事件（绑定选中日期）\n     * 后端接口建议：GET /daily-events?date=2026-04-08\n     */\n    async getDailyEvents() {\n      if (!this.selectedDate) return;\n      try {\n        const res = await axios.get('/daily-events', {\n          params: { date: this.selectedDate } // 携带日期参数，和后端绑定\n        });\n        // 后端返回格式建议：[{ id: 1, content: '事件1', date: '2026-04-08' }, ...]\n        this.dailyEvents = res.data.data || [];\n      } catch (error) {\n        console.error('获取当日事件失败：', error);\n        this.$message.error('获取事件失败，请重试');\n      }\n    },\n\n    /**\n     * 2. 删除当日事件\n     * 后端接口建议：DELETE /daily-events/{id}\n     */\n    async deleteDailyEvent(eventId) {\n      if (!eventId) return;\n      try {\n        await axios.delete(`/daily-events/${eventId}`);\n        // 前端实时更新：过滤掉删除的事件（无需重新请求，提升体验）\n        this.dailyEvents = this.dailyEvents.filter(item => item.id !== eventId);\n        this.$message.success('事件删除成功');\n      } catch (error) {\n        console.error('删除当日事件失败：', error);\n        this.$message.error('删除事件失败，请重试');\n      }\n    },\n\n    /**\n     * 3. 获取所有备忘录（独立，不携带日期）\n     * 后端接口建议：GET /memos\n     */\n    async getMemos() {\n      try {\n        const res = await axios.get('/memos');\n        // 后端返回格式建议：[{ id: 1, content: '备忘录1' }, ...]\n        this.memos = res.data.data || [];\n      } catch (error) {\n        console.error('获取备忘录失败：', error);\n        this.$message.error('获取备忘录失败，请重试');\n      }\n    },\n\n    /**\n     * 4. 删除备忘录\n     * 后端接口建议：DELETE /memos/{id}\n     */\n    async deleteMemo(memoId) {\n      if (!memoId) return;\n      try {\n        await axios.delete(`/memos/${memoId}`);\n        // 前端实时更新：过滤掉删除的备忘录\n        this.memos = this.memos.filter(item => item.id !== memoId);\n        this.$message.success('备忘录删除成功');\n      } catch (error) {\n        console.error('删除备忘录失败：', error);\n        this.$message.error('删除备忘录失败，请重试');\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n/* 核心布局（保留你之前的） */\n.calendar-grid-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  padding: 15px;\n  height: calc(100vh - 80px);\n  box-sizing: border-box;\n}\n.calendar-left-section {\n  display: grid;\n  grid-template-rows: 1fr 1fr;\n  gap: 20px;\n  height: 100%;\n}\n.calendar-right-section {\n  height: 100%;\n}\n.card-content {\n  padding: 10px;\n  color: #333;\n  height: 100%;\n  box-sizing: border-box;\n}\n.card-content h5 {\n  margin-bottom: 15px;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 8px;\n}\n\n/* 新增：列表样式（逐行展示） */\n.event-list, .memo-list {\n  height: calc(100% - 40px); /* 减去标题高度 */\n  overflow-y: auto; /* 内容超出时滚动 */\n}\n.event-item, .memo-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 0;\n  border-bottom: 1px dashed #eee;\n}\n.event-text, .memo-text {\n  flex: 1;\n  word-break: break-all; /* 超长文本换行 */\n}\n.delete-btn {\n  color: #ff4949;\n  padding: 0;\n}\n.delete-btn:hover {\n  color: #ff1f1f;\n}\n\n/* 新增：空状态提示 */\n.empty-tip {\n  color: #999;\n  text-align: center;\n  padding: 20px 0;\n}\n.calendar-tip {\n  color: #666;\n  font-size: 14px;\n}\n</style>"],"mappings":";;AAkFA,OAAOA,YAAW,MAAO,+BAA+B;AACxD;AACA,OAAOC,KAAI,MAAO,OAAO;;AAEzB;AACAA,KAAK,CAACC,QAAQ,CAACC,OAAM,GAAI,2BAA2B,EAAE;;AAEtD,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,UAAU,EAAE;IACVL;EACF,CAAC;EACDM,IAAIA,CAAA,EAAG;IACL,OAAO;MACL;MACAC,YAAY,EAAE,EAAE;MAChB;MA