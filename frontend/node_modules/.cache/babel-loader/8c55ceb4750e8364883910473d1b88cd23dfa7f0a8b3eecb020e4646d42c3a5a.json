{"ast":null,"code":"import { ref } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios';\n// 复用公共卡片组件\nimport ContentField from '@/components/ContentField.vue';\n\n// axios基础路径（与CalendarIndexView.vue保持一致）\n\nexport default {\n  __name: 'MemorandumIndexView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    // Vue3 组合式API核心依赖\n    axios.defaults.baseURL = 'http://localhost:8080/api';\n\n    // 1. 表单数据（与后端接收参数对齐）\n    const eventForm = ref({\n      content: '',\n      // 事件内容\n      date: '' // 事件日期（格式：YYYY-MM-DD）\n    });\n\n    // 2. 表单校验规则（前端兜底校验，减少后端无效请求）\n    const eventRules = ref({\n      content: [{\n        required: true,\n        message: '请输入事件内容',\n        trigger: 'blur'\n      }, {\n        max: 500,\n        message: '事件内容不能超过500个字',\n        trigger: 'blur'\n      }],\n      date: [{\n        required: true,\n        message: '请选择事件日期',\n        trigger: 'change'\n      }]\n    });\n\n    // 3. 表单引用（用于校验/重置）\n    const eventFormRef = ref(null);\n\n    // 4. 提交事件（核心：调用后端添加接口）\n    const submitEvent = async () => {\n      // 第一步：前端表单校验\n      try {\n        await eventFormRef.value.validate();\n      } catch (error) {\n        ElMessage.warning('请完善表单必填项');\n        return;\n      }\n\n      // 第二步：调用后端接口提交数据\n      try {\n        const res = await axios.post('/daily-events', {\n          content: eventForm.value.content,\n          date: eventForm.value.date\n        });\n\n        // 后端响应处理（按统一格式判断）\n        if (res.data.code === 200) {\n          ElMessage.success('事件添加成功！');\n          resetForm(); // 清空表单\n          // 可选：添加成功后返回日历页面（如需路由跳转，需引入useRouter）\n          // const router = useRouter();\n          // router.push('/calendar');\n        } else {\n          ElMessage.error(res.data.msg || '添加失败，请重试');\n        }\n      } catch (err) {\n        // axios 1.x 错误处理（兼容网络/接口错误）\n        console.error('添加事件失败：', err.response?.data || err.message);\n        ElMessage.error('网络异常或服务器错误，请稍后重试');\n      }\n    };\n\n    // 5. 重置表单\n    const resetForm = () => {\n      eventFormRef.value.resetFields(); // 清空表单+重置校验\n      eventForm.value = {\n        content: '',\n        date: ''\n      }; // 重置数据\n    };\n    const __returned__ = {\n      eventForm,\n      eventRules,\n      eventFormRef,\n      submitEvent,\n      resetForm,\n      ref,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      },\n      ContentField\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ElMessage","axios","ContentField","defaults","baseURL","eventForm","content","date","eventRules","required","message","trigger","max","eventFormRef","submitEvent","value","validate","error","warning","res","post","data","code","success","resetForm","msg","err","console","response","resetFields"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/memorandum/MemorandumIndexView.vue"],"sourcesContent":["<template>\n  <div class=\"event-add-container\">\n    <!-- 外层卡片容器（复用ContentField组件保持风格统一） -->\n    <ContentField>\n      <div class=\"event-add-content\">\n        <!-- 页面标题 -->\n        <h3 class=\"page-title\">添加当日事件</h3>\n        \n        <!-- 表单区域 -->\n        <el-form \n          ref=\"eventFormRef\" \n          :model=\"eventForm\" \n          :rules=\"eventRules\" \n          label-width=\"100px\"\n          class=\"event-form\"\n        >\n          <!-- 事件内容输入框 -->\n          <el-form-item label=\"添加事件：\" prop=\"content\">\n            <el-input\n              v-model=\"eventForm.content\"\n              type=\"textarea\"\n              :rows=\"3\"\n              placeholder=\"请输入事件内容（如：上午9点开项目会议）\"\n              class=\"input-content\"\n            />\n          </el-form-item>\n\n          <!-- 日期选择框 -->\n          <el-form-item label=\"添加日期：\" prop=\"date\">\n            <el-date-picker\n              v-model=\"eventForm.date\"\n              type=\"date\"\n              placeholder=\"请选择事件日期\"\n              format=\"YYYY-MM-DD\"\n              value-format=\"YYYY-MM-DD\"\n              class=\"input-date\"\n            />\n          </el-form-item>\n\n          <!-- 提交按钮 -->\n          <el-form-item class=\"btn-group\">\n            <el-button type=\"primary\" @click=\"submitEvent\">添加</el-button>\n            <el-button @click=\"resetForm\">重置</el-button>\n          </el-form-item>\n        </el-form>\n      </div>\n    </ContentField>\n  </div>\n</template>\n\n<script setup>\n// Vue3 组合式API核心依赖\nimport { ref } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios';\n// 复用公共卡片组件\nimport ContentField from '@/components/ContentField.vue';\n\n// axios基础路径（与CalendarIndexView.vue保持一致）\naxios.defaults.baseURL = 'http://localhost:8080/api';\n\n// 1. 表单数据（与后端接收参数对齐）\nconst eventForm = ref({\n  content: '', // 事件内容\n  date: ''     // 事件日期（格式：YYYY-MM-DD）\n});\n\n// 2. 表单校验规则（前端兜底校验，减少后端无效请求）\nconst eventRules = ref({\n  content: [\n    { required: true, message: '请输入事件内容', trigger: 'blur' },\n    { max: 500, message: '事件内容不能超过500个字', trigger: 'blur' }\n  ],\n  date: [\n    { required: true, message: '请选择事件日期', trigger: 'change' }\n  ]\n});\n\n// 3. 表单引用（用于校验/重置）\nconst eventFormRef = ref(null);\n\n// 4. 提交事件（核心：调用后端添加接口）\nconst submitEvent = async () => {\n  // 第一步：前端表单校验\n  try {\n    await eventFormRef.value.validate();\n  } catch (error) {\n    ElMessage.warning('请完善表单必填项');\n    return;\n  }\n\n  // 第二步：调用后端接口提交数据\n  try {\n    const res = await axios.post('/daily-events', {\n      content: eventForm.value.content,\n      date: eventForm.value.date\n    });\n\n    // 后端响应处理（按统一格式判断）\n    if (res.data.code === 200) {\n      ElMessage.success('事件添加成功！');\n      resetForm(); // 清空表单\n      // 可选：添加成功后返回日历页面（如需路由跳转，需引入useRouter）\n      // const router = useRouter();\n      // router.push('/calendar');\n    } else {\n      ElMessage.error(res.data.msg || '添加失败，请重试');\n    }\n  } catch (err) {\n    // axios 1.x 错误处理（兼容网络/接口错误）\n    console.error('添加事件失败：', err.response?.data || err.message);\n    ElMessage.error('网络异常或服务器错误，请稍后重试');\n  }\n};\n\n// 5. 重置表单\nconst resetForm = () => {\n  eventFormRef.value.resetFields(); // 清空表单+重置校验\n  eventForm.value = { content: '', date: '' }; // 重置数据\n};\n</script>\n\n<style scoped>\n/* 页面容器：居中+适配高度 */\n.event-add-container {\n  width: 100%;\n  max-width: 800px; /* 限制最大宽度，避免太宽 */\n  margin: 20px auto; /* 水平居中 */\n  padding: 0 15px;\n  box-sizing: border-box;\n}\n\n/* 表单内容区域 */\n.event-add-content {\n  padding: 20px;\n}\n\n/* 页面标题 */\n.page-title {\n  text-align: center;\n  margin-bottom: 30px;\n  color: #333;\n  font-weight: 600;\n}\n\n/* 表单样式 */\n.event-form {\n  width: 100%;\n}\n\n/* 输入框样式 */\n.input-content, .input-date {\n  width: 100%;\n}\n\n/* 按钮组 */\n.btn-group {\n  display: flex;\n  justify-content: center;\n  margin-top: 20px;\n}\n\n.btn-group .el-button {\n  margin: 0 10px;\n  width: 120px;\n}\n</style>"],"mappings":"AAoDA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,KAAK,MAAM,OAAO;AACzB;AACA,OAAOC,YAAY,MAAM,+BAA+B;;AAExD;;;;;;;;;IAPA;IAQAD,KAAK,CAACE,QAAQ,CAACC,OAAO,GAAG,2BAA2B;;IAEpD;IACA,MAAMC,SAAS,GAAGN,GAAG,CAAC;MACpBO,OAAO,EAAE,EAAE;MAAE;MACbC,IAAI,EAAE,EAAE,CAAK;IACf,CAAC,CAAC;;IAEF;IACA,MAAMC,UAAU,GAAGT,GAAG,CAAC;MACrBO,OAAO,EAAE,CACP;QAAEG,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAO,CAAC,EACvD;QAAEC,GAAG,EAAE,GAAG;QAAEF,OAAO,EAAE,eAAe;QAAEC,OAAO,EAAE;MAAO,EACvD;MACDJ,IAAI,EAAE,CACJ;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAS;IAE5D,CAAC,CAAC;;IAEF;IACA,MAAME,YAAY,GAAGd,GAAG,CAAC,IAAI,CAAC;;IAE9B;IACA,MAAMe,WAAW,GAAG,MAAAA,CAAA,KAAY;MAC9B;MACA,IAAI;QACF,MAAMD,YAAY,CAACE,KAAK,CAACC,QAAQ,CAAC,CAAC;MACrC,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdjB,SAAS,CAACkB,OAAO,CAAC,UAAU,CAAC;QAC7B;MACF;;MAEA;MACA,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMlB,KAAK,CAACmB,IAAI,CAAC,eAAe,EAAE;UAC5Cd,OAAO,EAAED,SAAS,CAACU,KAAK,CAACT,OAAO;UAChCC,IAAI,EAAEF,SAAS,CAACU,KAAK,CAACR;QACxB,CAAC,CAAC;;QAEF;QACA,IAAIY,GAAG,CAACE,IAAI,CAACC,IAAI,KAAK,GAAG,EAAE;UACzBtB,SAAS,CAACuB,OAAO,CAAC,SAAS,CAAC;UAC5BC,SAAS,CAAC,CAAC,CAAC,CAAC;UACb;UACA;UACA;QACF,CAAC,MAAM;UACLxB,SAAS,CAACiB,KAAK,CAACE,GAAG,CAACE,IAAI,CAACI,GAAG,IAAI,UAAU,CAAC;QAC7C;MACF,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZ;QACAC,OAAO,CAACV,KAAK,CAAC,SAAS,EAAES,GAAG,CAACE,QAAQ,EAAEP,IAAI,IAAIK,GAAG,CAAChB,OAAO,CAAC;QAC3DV,SAAS,CAACiB,KAAK,CAAC,kBAAkB,CAAC;MACrC;IACF,CAAC;;IAED;IACA,MAAMO,SAAS,GAAGA,CAAA,KAAM;MACtBX,YAAY,CAACE,KAAK,CAACc,WAAW,CAAC,CAAC,CAAC,CAAC;MAClCxB,SAAS,CAACU,KAAK,GAAG;QAAET,OAAO,EAAE,EAAE;QAAEC,IAAI,EAAE;MAAG,CAAC,CAAC,CAAC;IAC/C,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}