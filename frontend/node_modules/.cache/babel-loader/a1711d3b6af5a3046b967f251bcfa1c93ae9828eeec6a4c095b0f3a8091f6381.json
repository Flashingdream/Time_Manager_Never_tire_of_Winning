{"ast":null,"code":"import { ref } from 'vue';\n// 仅引入用到的ElMessage，避免ESLint报错\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios';\n// 复用公共卡片组件\nimport ContentField from '@/components/ContentField.vue';\n\n// axios基础路径（与其他页面保持一致）\n\nexport default {\n  __name: 'EventIndexView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    // Vue3 组合式API核心依赖\n    axios.defaults.baseURL = 'http://localhost:8080/api';\n\n    // 1. 表单数据（仅content，无date字段）\n    const memoForm = ref({\n      content: '' // 备忘录内容\n    });\n\n    // 2. 表单校验规则\n    const memoRules = ref({\n      content: [{\n        required: true,\n        message: '请输入备忘录内容',\n        trigger: 'blur'\n      }, {\n        max: 500,\n        message: '备忘录内容不能超过500个字',\n        trigger: 'blur'\n      }]\n    });\n\n    // 3. 表单引用\n    const memoFormRef = ref(null);\n\n    // 4. 提交备忘录（核心：调用后端新增接口）\n    const submitMemo = async () => {\n      // 第一步：前端表单校验\n      try {\n        await memoFormRef.value.validate();\n      } catch (error) {\n        ElMessage.warning('请完善备忘录内容');\n        return;\n      }\n\n      // 第二步：调用后端接口\n      try {\n        const res = await axios.post('/memos', {\n          content: memoForm.value.content // 仅传内容，无日期\n        });\n\n        // 后端响应处理\n        if (res.data.code === 200) {\n          ElMessage.success('备忘录添加成功！');\n          resetForm(); // 清空表单\n          // 可选：添加成功后返回日历页面\n          // const router = useRouter();\n          // router.push('/calendar');\n        } else {\n          ElMessage.error(res.data.msg || '添加失败，请重试');\n        }\n      } catch (err) {\n        // axios 1.x 错误处理\n        console.error('添加备忘录失败：', err.response?.data || err.message);\n        ElMessage.error('网络异常或服务器错误，请稍后重试');\n      }\n    };\n\n    // 5. 重置表单\n    const resetForm = () => {\n      memoFormRef.value.resetFields();\n      memoForm.value = {\n        content: ''\n      };\n    };\n    const __returned__ = {\n      memoForm,\n      memoRules,\n      memoFormRef,\n      submitMemo,\n      resetForm,\n      ref,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      },\n      ContentField\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ElMessage","axios","ContentField","defaults","baseURL","memoForm","content","memoRules","required","message","trigger","max","memoFormRef","submitMemo","value","validate","error","warning","res","post","data","code","success","resetForm","msg","err","console","response","resetFields"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/event/EventIndexView.vue"],"sourcesContent":["<template>\n  <div class=\"memo-add-container\">\n    <!-- 复用公共卡片组件，保持风格统一 -->\n    <ContentField>\n      <div class=\"memo-add-content\">\n        <!-- 页面标题 -->\n        <h3 class=\"page-title\">添加备忘录</h3>\n        \n        <!-- 备忘录表单 -->\n        <el-form \n          ref=\"memoFormRef\" \n          :model=\"memoForm\" \n          :rules=\"memoRules\" \n          label-width=\"100px\"\n          class=\"memo-form\"\n        >\n          <!-- 备忘录内容输入框 -->\n          <el-form-item label=\"备忘录内容：\" prop=\"content\">\n            <el-input\n              v-model=\"memoForm.content\"\n              type=\"textarea\"\n              :rows=\"5\"\n              placeholder=\"请输入备忘录内容（如：买牛奶、整理桌面）\"\n              class=\"input-content\"\n            />\n          </el-form-item>\n\n          <!-- 提交/重置按钮 -->\n          <el-form-item class=\"btn-group\">\n            <el-button type=\"primary\" @click=\"submitMemo\">添加</el-button>\n            <el-button @click=\"resetForm\">重置</el-button>\n          </el-form-item>\n        </el-form>\n      </div>\n    </ContentField>\n  </div>\n</template>\n\n<script setup>\n// Vue3 组合式API核心依赖\nimport { ref } from 'vue';\n// 仅引入用到的ElMessage，避免ESLint报错\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios';\n// 复用公共卡片组件\nimport ContentField from '@/components/ContentField.vue';\n\n// axios基础路径（与其他页面保持一致）\naxios.defaults.baseURL = 'http://localhost:8080/api';\n\n// 1. 表单数据（仅content，无date字段）\nconst memoForm = ref({\n  content: '' // 备忘录内容\n});\n\n// 2. 表单校验规则\nconst memoRules = ref({\n  content: [\n    { required: true, message: '请输入备忘录内容', trigger: 'blur' },\n    { max: 500, message: '备忘录内容不能超过500个字', trigger: 'blur' }\n  ]\n});\n\n// 3. 表单引用\nconst memoFormRef = ref(null);\n\n// 4. 提交备忘录（核心：调用后端新增接口）\nconst submitMemo = async () => {\n  // 第一步：前端表单校验\n  try {\n    await memoFormRef.value.validate();\n  } catch (error) {\n    ElMessage.warning('请完善备忘录内容');\n    return;\n  }\n\n  // 第二步：调用后端接口\n  try {\n    const res = await axios.post('/memos', {\n      content: memoForm.value.content // 仅传内容，无日期\n    });\n\n    // 后端响应处理\n    if (res.data.code === 200) {\n      ElMessage.success('备忘录添加成功！');\n      resetForm(); // 清空表单\n      // 可选：添加成功后返回日历页面\n      // const router = useRouter();\n      // router.push('/calendar');\n    } else {\n      ElMessage.error(res.data.msg || '添加失败，请重试');\n    }\n  } catch (err) {\n    // axios 1.x 错误处理\n    console.error('添加备忘录失败：', err.response?.data || err.message);\n    ElMessage.error('网络异常或服务器错误，请稍后重试');\n  }\n};\n\n// 5. 重置表单\nconst resetForm = () => {\n  memoFormRef.value.resetFields();\n  memoForm.value = { content: '' };\n};\n</script>\n\n<style scoped>\n/* 页面容器：居中+限制宽度 */\n.memo-add-container {\n  width: 100%;\n  max-width: 800px;\n  margin: 20px auto;\n  padding: 0 15px;\n  box-sizing: border-box;\n}\n\n/* 表单内容区域 */\n.memo-add-content {\n  padding: 20px;\n}\n\n/* 页面标题 */\n.page-title {\n  text-align: center;\n  margin-bottom: 30px;\n  color: #333;\n  font-weight: 600;\n}\n\n/* 表单样式 */\n.memo-form {\n  width: 100%;\n}\n\n/* 输入框样式 */\n.input-content {\n  width: 100%;\n}\n\n/* 按钮组 */\n.btn-group {\n  display: flex;\n  justify-content: center;\n  margin-top: 20px;\n}\n\n.btn-group .el-button {\n  margin: 0 10px;\n  width: 120px;\n}\n</style>"],"mappings":"AAwCA,SAASA,GAAG,QAAQ,KAAK;AACzB;AACA,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,KAAK,MAAM,OAAO;AACzB;AACA,OAAOC,YAAY,MAAM,+BAA+B;;AAExD;;;;;;;;;IARA;IASAD,KAAK,CAACE,QAAQ,CAACC,OAAO,GAAG,2BAA2B;;IAEpD;IACA,MAAMC,QAAQ,GAAGN,GAAG,CAAC;MACnBO,OAAO,EAAE,EAAE,CAAC;IACd,CAAC,CAAC;;IAEF;IACA,MAAMC,SAAS,GAAGR,GAAG,CAAC;MACpBO,OAAO,EAAE,CACP;QAAEE,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,UAAU;QAAEC,OAAO,EAAE;MAAO,CAAC,EACxD;QAAEC,GAAG,EAAE,GAAG;QAAEF,OAAO,EAAE,gBAAgB;QAAEC,OAAO,EAAE;MAAO;IAE3D,CAAC,CAAC;;IAEF;IACA,MAAME,WAAW,GAAGb,GAAG,CAAC,IAAI,CAAC;;IAE7B;IACA,MAAMc,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B;MACA,IAAI;QACF,MAAMD,WAAW,CAACE,KAAK,CAACC,QAAQ,CAAC,CAAC;MACpC,CAAC,CAAC,OAAOC,KAAK,EAAE;QACdhB,SAAS,CAACiB,OAAO,CAAC,UAAU,CAAC;QAC7B;MACF;;MAEA;MACA,IAAI;QACF,MAAMC,GAAG,GAAG,MAAMjB,KAAK,CAACkB,IAAI,CAAC,QAAQ,EAAE;UACrCb,OAAO,EAAED,QAAQ,CAACS,KAAK,CAACR,OAAO,CAAC;QAClC,CAAC,CAAC;;QAEF;QACA,IAAIY,GAAG,CAACE,IAAI,CAACC,IAAI,KAAK,GAAG,EAAE;UACzBrB,SAAS,CAACsB,OAAO,CAAC,UAAU,CAAC;UAC7BC,SAAS,CAAC,CAAC,CAAC,CAAC;UACb;UACA;UACA;QACF,CAAC,MAAM;UACLvB,SAAS,CAACgB,KAAK,CAACE,GAAG,CAACE,IAAI,CAACI,GAAG,IAAI,UAAU,CAAC;QAC7C;MACF,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZ;QACAC,OAAO,CAACV,KAAK,CAAC,UAAU,EAAES,GAAG,CAACE,QAAQ,EAAEP,IAAI,IAAIK,GAAG,CAAChB,OAAO,CAAC;QAC5DT,SAAS,CAACgB,KAAK,CAAC,kBAAkB,CAAC;MACrC;IACF,CAAC;;IAED;IACA,MAAMO,SAAS,GAAGA,CAAA,KAAM;MACtBX,WAAW,CAACE,KAAK,CAACc,WAAW,CAAC,CAAC;MAC/BvB,QAAQ,CAACS,KAAK,GAAG;QAAER,OAAO,EAAE;MAAG,CAAC;IAClC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}