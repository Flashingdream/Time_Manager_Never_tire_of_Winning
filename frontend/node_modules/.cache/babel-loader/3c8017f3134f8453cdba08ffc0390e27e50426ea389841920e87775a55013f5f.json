{"ast":null,"code":"import ContentField from '@/components/ContentField.vue';\nexport default {\n  components: {\n    ContentField\n  }\n};","map":{"version":3,"names":["ContentField","components"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/calendar/CalendarIndexView.vue"],"sourcesContent":["<template>\n  <!-- 外层 Grid 布局容器 -->\n  <div class=\"calendar-grid-container\">\n    \n    <!-- 左侧区域：包含两个卡片 -->\n    <div class=\"calendar-left-section\">\n      <!-- 1. 普通日历列表 -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>普通日历列表</h5>\n          <!-- 这里可以放具体的日历组件或列表 -->\n        </div>\n      </ContentField>\n\n      <!-- 2. 当日事件 -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>当日事件：</h5>\n          <!-- 这里可以放具体的事件列表 -->\n        </div>\n      </ContentField>\n    </div>\n\n    <!-- 右侧区域：包含一个大卡片 -->\n    <div class=\"calendar-right-section\">\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>备忘录</h5>\n          <!-- 这里可以放具体的备忘录内容 -->\n        </div>\n      </ContentField>\n    </div>\n\n  </div>\n</template>\n\n<script>   \nimport ContentField from '@/components/ContentField.vue'; \n\nexport default {\n    components: {\n        ContentField,\n    },\n}\n</script>\n\n<style scoped>  \n/*\n * 核心布局：CSS Grid\n * 屏幕分为两列：左边 2 份，右边 1 份\n */\n.calendar-grid-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr; /* 左侧宽度是右侧的2倍 */\n  gap: 20px; /* 模块之间的间距 */\n  padding: 15px; /* 容器内边距 */\n  height: calc(100vh - 80px); /* 占满屏幕高度（减去 NavBar 的高度） */\n  box-sizing: border-box;\n}\n\n/*\n * 左侧内部布局：垂直排列两个卡片\n */\n.calendar-left-section {\n  display: grid;\n  grid-template-rows: 1fr 1fr; /* 上下两个区域高度相等 */\n  gap: 2px; /* 上下两个卡片之间的间距 */\n  height: 100%;\n}\n\n/*\n * 右侧高度：需要和左侧顶部高度对齐，所以也占满父容器\n */\n.calendar-right-section {\n  height: 100%;\n}\n\n/*\n * 卡片内部内容美化\n */\n.card-content {\n  padding: 10px;\n  color: #333;\n}\n\n.card-content h5 {\n  margin-bottom: 15px;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 8px;\n}\n</style>"],"mappings":"AAqCA,OAAOA,YAAW,MAAO,+BAA+B;AAExD,eAAe;EACXC,UAAU,EAAE;IACRD;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}