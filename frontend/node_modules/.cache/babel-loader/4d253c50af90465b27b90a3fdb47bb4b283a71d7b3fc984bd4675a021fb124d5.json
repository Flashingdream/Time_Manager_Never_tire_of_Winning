{"ast":null,"code":"import $ from 'jquery'; // 引入 jQuery 库\nimport { ref } from 'vue'; // 引入 ref 函数，用于创建响应式数据\n\nexport default {\n  name: 'App',\n  setup: () => {\n    let bot_name = ref(\"\"); // 创建一个响应式变量 bot_name\n    let bot_rating = ref(\"\"); // 创建一个响应式变量 bot_rating\n\n    $.ajax({\n      // 使用 jQuery 的 ajax 方法请求后端数据\n      url: \"http://127.0.0.1:3000/pk/getbotinfo/\",\n      type: \"get\",\n      // 请求类型为 GET\n      success: resp => {\n        bot_name.value = resp.name; // 将响应中的 bot_name 赋值给 bot_name 变量\n        bot_rating.value = resp.rating; // 将响应中的 bot_rating 赋值给 bot_rating 变量\n      }\n    });\n    return {\n      bot_name,\n      bot_rating\n    };\n  }\n};","map":{"version":3,"names":["$","ref","name","setup","bot_name","bot_rating","ajax","url","type","success","resp","value","rating"],"sources":["/Users/fate_gate/Desktop/Spring/kob/web/src/App.vue"],"sourcesContent":["<template>\n <div>\n    <div>Bot昵称：{{ bot_name }}</div>\n    <div>Bot战力：{{ bot_rating }}</div>\n</div>\n  <router-view/>\n</template>\n\n<script>  \nimport $ from 'jquery';  // 引入 jQuery 库\nimport { ref } from 'vue';  // 引入 ref 函数，用于创建响应式数据\n\nexport default \n{\n  name: 'App',\n  setup: () => \n  {\n    let bot_name = ref(\"\");  // 创建一个响应式变量 bot_name\n    let bot_rating = ref(\"\");  // 创建一个响应式变量 bot_rating\n\n    $.ajax({    // 使用 jQuery 的 ajax 方法请求后端数据\n      url: \"http://127.0.0.1:3000/pk/getbotinfo/\",\n\n      type: \"get\",  // 请求类型为 GET\n      success: resp => {\n        bot_name.value = resp.name;  // 将响应中的 bot_name 赋值给 bot_name 变量\n        bot_rating.value = resp.rating;  // 将响应中的 bot_rating 赋值给 bot_rating 变量\n      }\n    });\n\n    return{\n      bot_name,\n      bot_rating\n    }\n  }\n}\n</script>\n\n<style>\n\n</style>\n"],"mappings":"AASA,OAAOA,CAAA,MAAO,QAAQ,EAAG;AACzB,SAASC,GAAE,QAAS,KAAK,EAAG;;AAE5B,eACA;EACEC,IAAI,EAAE,KAAK;EACXC,KAAK,EAAEA,CAAA,KACP;IACE,IAAIC,QAAO,GAAIH,GAAG,CAAC,EAAE,CAAC,EAAG;IACzB,IAAII,UAAS,GAAIJ,GAAG,CAAC,EAAE,CAAC,EAAG;;IAE3BD,CAAC,CAACM