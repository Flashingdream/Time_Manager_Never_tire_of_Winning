{"ast":null,"code":"import { useRoute } from 'vue-router'; // 导入 useRoute 函数，用于获取当前路由信息\nimport { computed } from 'vue'; // 导入 computed 函数，用于创建计算属性\n\nexport default {\n  setup() {\n    const route = useRoute(); // 获取当前路由信息\n    let route_name = computed(() => route.name); // 创建一个计算属性 route_name，返回当前路由的名称\n    return {\n      route_name // 将 route_name 返回，使其可以在模板中使用\n    }; // 这样子再配合上面template的代码就可以实现导航栏中对应的菜单项高亮显示了\n  }\n};","map":{"version":3,"names":["useRoute","computed","setup","route","route_name","name"],"sources":["/Users/fate_gate/Desktop/Spring/kob/web/src/components/NabBar.vue"],"sourcesContent":["<template>\n    <nav class=\"navbar navbar-expand-lg navbar-dark bg-dark\">\n  <div class=\"container\">\n    \n    <router-link class=\"navbar-brand\" :to=\"{name : 'home'}\">King Of Bots</router-link>\n    <div class=\"collapse navbar-collapse\" id=\"navbarText\">\n      <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n        <li class=\"nav-item\">\n          \n          <router-link :class=\"route_name =='pk_index' ? 'nav-link active' : 'nav-link'\" :to=\"{name: 'pk_index'}\">对战</router-link>\n        </li>\n        <li class=\"nav-item\">\n          <router-link :class=\"route_name =='record_index' ? 'nav-link active' : 'nav-link'\" :to=\"{name: 'record_index'}\">对局列表</router-link>\n        </li>\n        <li class=\"nav-item\">\n          <router-link :class=\"route_name =='ranklist_index' ? 'nav-link active' : 'nav-link'\" :to=\"{name: 'ranklist_index'}\">排行榜</router-link>\n        </li>\n      </ul>\n     <ul class=\"navbar-nav\">   \n        <li class=\"nav-item dropdown\">\n          <a class=\"nav-link dropdown-toggle\" href=\"#\" id=\"navbarDropdown\" role=\"button\" data-bs-toggle=\"dropdown\" aria-expanded=\"false\">\n            苏菲\n          </a>\n          <ul class=\"dropdown-menu\" aria-labelledby=\"navbarDropdown\">\n            <li>\n                <router-link class=\"dropdown-item\" :to=\"{name: 'user_bot_index'}\">我的Bot</router-link>\n            </li>\n\n            <li><hr class=\"dropdown-divider\"></li>\n            <li><a class=\"dropdown-item\" href=\"#\">退出</a></li>\n          </ul>\n        </li>\n     </ul>\n    </div>\n  </div>\n</nav>\n</template>\n\n<script> \nimport { useRoute } from 'vue-router';  // 导入 useRoute 函数，用于获取当前路由信息\nimport { computed } from 'vue';  // 导入 computed 函数，用于创建计算属性\n\nexport default {\n    setup(){\n        const route = useRoute();  // 获取当前路由信息\n        let route_name = computed(() => route.name);  // 创建一个计算属性 route_name，返回当前路由的名称\n        return {\n            route_name,  // 将 route_name 返回，使其可以在模板中使用\n        }   // 这样子再配合上面template的代码就可以实现导航栏中对应的菜单项高亮显示了\n\n    }\n}\n</script>\n\n<style scoped>  /* scoped 属性表示该样式只作用于当前组件，避免样式冲突 */\n\n</style>"],"mappings":"AAuCA,SAASA,QAAO,QAAS,YAAY,EAAG;AACxC,SAASC,QAAO,QAAS,KAAK,EAAG;;AAEjC,eAAe;EACXC,KAAKA,CAAA,EAAE;IACH,MAAMC,KAAI,GAAIH,QAAQ,CAAC,CAAC,EAAG;IAC3B,IAAII,UAAS,GAAIH,QAAQ,CAAC,MAAME,KAAK,CAACE,IAAI,CAAC,EAAG;IAC9C,OAAO;MACHD,UAAU,CAAG;IACjB,GAAI;EAER;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}