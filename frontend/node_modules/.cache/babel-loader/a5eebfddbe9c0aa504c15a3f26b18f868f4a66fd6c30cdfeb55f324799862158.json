{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport { useRouter } from 'vue-router';\nexport default {\n  __name: 'LoginView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n\n    // 1. 登录表单数据\n    const loginForm = ref({\n      username: '',\n      password: ''\n    });\n\n    // 2. 极简登录逻辑（本地固定账号密码）\n    const handleLogin = () => {\n      // 本地模拟校验：固定账号admin，密码123456\n      if (loginForm.value.username === 'admin' && loginForm.value.password === '123456') {\n        // 存储登录态（本地localStorage）\n        localStorage.setItem('isLogin', 'true'); // 标记已登录\n        localStorage.setItem('username', loginForm.value.username); // 存储用户名\n        ElMessage.success('登录成功！');\n        router.push('/calendar'); // 跳转到日历首页\n      } else {\n        ElMessage.error('账号或密码错误（默认：admin/123456）');\n      }\n    };\n    const __returned__ = {\n      router,\n      loginForm,\n      handleLogin,\n      ref,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get useRouter() {\n        return useRouter;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ElMessage","useRouter","router","loginForm","username","password","handleLogin","value","localStorage","setItem","success","push","error"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/login/LoginView.vue"],"sourcesContent":["<template>\n  <div class=\"simple-login-container\">\n    <div class=\"login-card\">\n      <h3>时间管理系统 - 登录</h3>\n      <el-form :model=\"loginForm\" @submit.prevent=\"handleLogin\" label-width=\"60px\">\n        <el-form-item label=\"账号\">\n          <el-input v-model=\"loginForm.username\" placeholder=\"请输入账号\" />\n        </el-form-item>\n        <el-form-item label=\"密码\">\n          <el-input v-model=\"loginForm.password\" type=\"password\" placeholder=\"请输入密码\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" @click=\"handleLogin\" class=\"login-btn\">登录</el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport { useRouter } from 'vue-router';\n\nconst router = useRouter();\n\n// 1. 登录表单数据\nconst loginForm = ref({\n  username: '',\n  password: ''\n});\n\n// 2. 极简登录逻辑（本地固定账号密码）\nconst handleLogin = () => {\n  // 本地模拟校验：固定账号admin，密码123456\n  if (loginForm.value.username === 'admin' && loginForm.value.password === '123456') {\n    // 存储登录态（本地localStorage）\n    localStorage.setItem('isLogin', 'true'); // 标记已登录\n    localStorage.setItem('username', loginForm.value.username); // 存储用户名\n    ElMessage.success('登录成功！');\n    router.push('/calendar'); // 跳转到日历首页\n  } else {\n    ElMessage.error('账号或密码错误（默认：admin/123456）');\n  }\n};\n</script>\n\n<style scoped>\n/* 极简样式，保证页面居中即可 */\n.simple-login-container {\n  width: 100%;\n  height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  background-color: #f5f5f5;\n}\n\n.login-card {\n  width: 350px;\n  padding: 30px;\n  background: #fff;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px rgba(0,0,0,0.1);\n}\n\n.login-card h3 {\n  text-align: center;\n  margin-bottom: 20px;\n  color: #333;\n}\n\n.login-btn {\n  width: 100%;\n}\n</style>"],"mappings":";AAoBA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,SAAS,QAAQ,cAAc;AACxC,SAASC,SAAS,QAAQ,YAAY;;;;;;;IAEtC,MAAMC,MAAM,GAAGD,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAME,SAAS,GAAGJ,GAAG,CAAC;MACpBK,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,WAAW,GAAGA,CAAA,KAAM;MACxB;MACA,IAAIH,SAAS,CAACI,KAAK,CAACH,QAAQ,KAAK,OAAO,IAAID,SAAS,CAACI,KAAK,CAACF,QAAQ,KAAK,QAAQ,EAAE;QACjF;QACAG,YAAY,CAACC,OAAO,CAAC,SAAS,EAAE,MAAM,CAAC,CAAC,CAAC;QACzCD,YAAY,CAACC,OAAO,CAAC,UAAU,EAAEN,SAAS,CAACI,KAAK,CAACH,QAAQ,CAAC,CAAC,CAAC;QAC5DJ,SAAS,CAACU,OAAO,CAAC,OAAO,CAAC;QAC1BR,MAAM,CAACS,IAAI,CAAC,WAAW,CAAC,CAAC,CAAC;MAC5B,CAAC,MAAM;QACLX,SAAS,CAACY,KAAK,CAAC,0BAA0B,CAAC;MAC7C;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}