{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { ref, onMounted } from 'vue';\nimport { ElMessage } from 'element-plus'; // Vue3 用 Element Plus 的 ElMessage\nimport ContentField from '@/components/ContentField.vue';\nimport axios from 'axios';\n\n// 配置axios基础路径（替换为你的后端接口地址）\n\nexport default {\n  __name: 'CalendarIndexView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    // Vue3 组合式API：setup 语法糖\n    axios.defaults.baseURL = 'http://localhost:8080/api';\n\n    // 响应式数据（Vue3 用 ref 替代 data）\n    const selectedDate = ref('');\n    const dailyEvents = ref([]);\n    const memos = ref([]);\n\n    // 页面加载时初始化（替代 created 钩子）\n    onMounted(() => {\n      // 设置默认日期为今日（格式：YYYY-MM-DD）\n      selectedDate.value = new Date().toISOString().split('T')[0];\n      getDailyEvents();\n      getMemos();\n    });\n\n    /**\n     * 1. 获取当日事件（修复 axios 错误处理 + Vue3 响应式）\n     */\n    const formatDateValue = value => {\n      if (!value) return '';\n      if (typeof value === 'string') return value;\n      if (value instanceof Date) return value.toISOString().split('T')[0];\n      return String(value);\n    };\n    const getDailyEvents = async () => {\n      if (!selectedDate.value) return;\n      const dateValue = formatDateValue(selectedDate.value);\n      try {\n        const res = await axios.get('/daily-events', {\n          params: {\n            date: dateValue\n          }\n        });\n        dailyEvents.value = res.data.data || [];\n      } catch (err) {\n        // axios 1.x 错误处理：兼容网络错误/接口错误\n        console.error('获取当日事件失败：', err.response?.data || err.message);\n        ElMessage.error('获取事件失败，请重试'); // Vue3 用 ElMessage 替代 this.$message\n      }\n    };\n\n    /**\n     * 2. 删除当日事件\n     */\n    const deleteDailyEvent = async eventId => {\n      if (!eventId) return;\n      try {\n        await axios.delete(`/daily-events/${eventId}`);\n        // 过滤删除的事件\n        dailyEvents.value = dailyEvents.value.filter(item => item.id !== eventId);\n        ElMessage.success('事件删除成功');\n      } catch (err) {\n        console.error('删除当日事件失败：', err.response?.data || err.message);\n        ElMessage.error('删除事件失败，请重试');\n      }\n    };\n\n    /**\n     * 3. 获取所有备忘录\n     */\n    const getMemos = async () => {\n      try {\n        const res = await axios.get('/memos');\n        memos.value = res.data.data || [];\n      } catch (err) {\n        console.error('获取备忘录失败：', err.response?.data || err.message);\n        ElMessage.error('获取备忘录失败，请重试');\n      }\n    };\n\n    /**\n     * 4. 删除备忘录\n     */\n    const deleteMemo = async memoId => {\n      if (!memoId) return;\n      try {\n        await axios.delete(`/memos/${memoId}`);\n        // 过滤删除的备忘录\n        memos.value = memos.value.filter(item => item.id !== memoId);\n        ElMessage.success('备忘录删除成功');\n      } catch (err) {\n        console.error('删除备忘录失败：', err.response?.data || err.message);\n        ElMessage.error('删除备忘录失败，请重试');\n      }\n    };\n    const __returned__ = {\n      selectedDate,\n      dailyEvents,\n      memos,\n      formatDateValue,\n      getDailyEvents,\n      deleteDailyEvent,\n      getMemos,\n      deleteMemo,\n      ref,\n      onMounted,\n      get ElMessage() {\n        return ElMessage;\n      },\n      ContentField,\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","ElMessage","ContentField","axios","defaults","baseURL","selectedDate","dailyEvents","memos","value","Date","toISOString","split","getDailyEvents","getMemos","formatDateValue","String","dateValue","res","get","params","date","data","err","console","error","response","message","deleteDailyEvent","eventId","delete","filter","item","id","success","deleteMemo","memoId"],"sources":["/Users/fate_gate/Desktop/Spring/homework_1_1/frontend/src/views/calendar/CalendarIndexView.vue"],"sourcesContent":["<template>\n  <div class=\"calendar-grid-container\">\n    <!-- 左侧区域：日历列表 + 当日事件 -->\n    <div class=\"calendar-left-section\">\n      <!-- 1. 普通日历列表（带日期选择） -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>普通日历列表</h5>\n          <!-- Element Plus 日期选择器（Vue3 版本） -->\n          <el-date-picker\n            v-model=\"selectedDate\"\n            type=\"date\"\n            placeholder=\"选择日期\"\n            format=\"YYYY-MM-DD\"\n            value-format=\"YYYY-MM-DD\"\n            @change=\"getDailyEvents\"\n            style=\"margin-bottom: 15px; width: 100%;\"\n          />\n          <!-- 日历简单展示 -->\n          <div class=\"calendar-tip\">当前选中：{{ selectedDate || '请选择日期' }}</div>\n        </div>\n      </ContentField>\n\n      <!-- 2. 当日事件（绑定选中日期，可删除） -->\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>当日事件：</h5>\n          <!-- 空状态提示 -->\n          <div v-if=\"dailyEvents.length === 0\" class=\"empty-tip\">暂无当日事件</div>\n          <!-- 事件列表：逐行展示 + 删除按钮 -->\n          <div v-else class=\"event-list\">\n            <div \n              v-for=\"(event, index) in dailyEvents\" \n              :key=\"event.id || index\" \n              class=\"event-item\"\n            >\n              <span class=\"event-text\">{{ event.content }}</span>\n              <el-button \n                type=\"text\" \n                icon=\"el-icon-delete\" \n                class=\"delete-btn\"\n                @click=\"deleteDailyEvent(event.id)\"\n              >\n                删除\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </ContentField>\n    </div>\n\n    <!-- 右侧区域：备忘录（独立，可删除） -->\n    <div class=\"calendar-right-section\">\n      <ContentField>\n        <div class=\"card-content\">\n          <h5>备忘录：</h5>\n          <!-- 空状态提示 -->\n          <div v-if=\"memos.length === 0\" class=\"empty-tip\">暂无备忘录</div>\n          <!-- 备忘录列表：逐行展示 + 删除按钮 -->\n          <div v-else class=\"memo-list\">\n            <div \n              v-for=\"(memo, index) in memos\" \n              :key=\"memo.id || index\" \n              class=\"memo-item\"\n            >\n              <span class=\"memo-text\">{{ memo.content }}</span>\n              <el-button \n                type=\"text\" \n                icon=\"el-icon-delete\" \n                class=\"delete-btn\"\n                @click=\"deleteMemo(memo.id)\"\n              >\n                删除\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </ContentField>\n    </div>\n  </div>\n</template>\n\n<script setup>\n// Vue3 组合式API：setup 语法糖\nimport { ref, onMounted } from 'vue';\nimport { ElMessage } from 'element-plus'; // Vue3 用 Element Plus 的 ElMessage\nimport ContentField from '@/components/ContentField.vue';\nimport axios from 'axios';\n\n// 配置axios基础路径（替换为你的后端接口地址）\naxios.defaults.baseURL = 'http://localhost:8080/api';\n\n// 响应式数据（Vue3 用 ref 替代 data）\nconst selectedDate = ref('');\nconst dailyEvents = ref([]);\nconst memos = ref([]);\n\n// 页面加载时初始化（替代 created 钩子）\nonMounted(() => {\n  // 设置默认日期为今日（格式：YYYY-MM-DD）\n  selectedDate.value = new Date().toISOString().split('T')[0];\n  getDailyEvents();\n  getMemos();\n});\n\n/**\n * 1. 获取当日事件（修复 axios 错误处理 + Vue3 响应式）\n */\nconst formatDateValue = (value) => {\n  if (!value) return '';\n  if (typeof value === 'string') return value;\n  if (value instanceof Date) return value.toISOString().split('T')[0];\n  return String(value);\n};\n\nconst getDailyEvents = async () => {\n  if (!selectedDate.value) return;\n  const dateValue = formatDateValue(selectedDate.value);\n  try {\n    const res = await axios.get('/daily-events', {\n      params: { date: dateValue }\n    });\n    dailyEvents.value = res.data.data || [];\n  } catch (err) {\n    // axios 1.x 错误处理：兼容网络错误/接口错误\n    console.error('获取当日事件失败：', err.response?.data || err.message);\n    ElMessage.error('获取事件失败，请重试'); // Vue3 用 ElMessage 替代 this.$message\n  }\n};\n\n/**\n * 2. 删除当日事件\n */\nconst deleteDailyEvent = async (eventId) => {\n  if (!eventId) return;\n  try {\n    await axios.delete(`/daily-events/${eventId}`);\n    // 过滤删除的事件\n    dailyEvents.value = dailyEvents.value.filter(item => item.id !== eventId);\n    ElMessage.success('事件删除成功');\n  } catch (err) {\n    console.error('删除当日事件失败：', err.response?.data || err.message);\n    ElMessage.error('删除事件失败，请重试');\n  }\n};\n\n/**\n * 3. 获取所有备忘录\n */\nconst getMemos = async () => {\n  try {\n    const res = await axios.get('/memos');\n    memos.value = res.data.data || [];\n  } catch (err) {\n    console.error('获取备忘录失败：', err.response?.data || err.message);\n    ElMessage.error('获取备忘录失败，请重试');\n  }\n};\n\n/**\n * 4. 删除备忘录\n */\nconst deleteMemo = async (memoId) => {\n  if (!memoId) return;\n  try {\n    await axios.delete(`/memos/${memoId}`);\n    // 过滤删除的备忘录\n    memos.value = memos.value.filter(item => item.id !== memoId);\n    ElMessage.success('备忘录删除成功');\n  } catch (err) {\n    console.error('删除备忘录失败：', err.response?.data || err.message);\n    ElMessage.error('删除备忘录失败，请重试');\n  }\n};\n</script>\n\n<style scoped>\n/* 核心布局（保留） */\n.calendar-grid-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  padding: 15px;\n  height: calc(100vh - 80px);\n  box-sizing: border-box;\n}\n.calendar-left-section {\n  display: grid;\n  grid-template-rows: 1fr 1fr;\n  gap: 20px;\n  height: 100%;\n}\n.calendar-right-section {\n  height: 100%;\n}\n.card-content {\n  padding: 10px;\n  color: #333;\n  height: 100%;\n  box-sizing: border-box;\n}\n.card-content h5 {\n  margin-bottom: 15px;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 8px;\n}\n\n/* 列表样式（逐行展示） */\n.event-list, .memo-list {\n  height: calc(100% - 40px);\n  overflow-y: auto;\n}\n.event-item, .memo-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 0;\n  border-bottom: 1px dashed #eee;\n}\n.event-text, .memo-text {\n  flex: 1;\n  word-break: break-all;\n}\n.delete-btn {\n  color: #ff4949;\n  padding: 0;\n}\n.delete-btn:hover {\n  color: #ff1f1f;\n}\n\n/* 空状态提示 */\n.empty-tip {\n  color: #999;\n  text-align: center;\n  padding: 20px 0;\n}\n.calendar-tip {\n  color: #666;\n  font-size: 14px;\n}\n</style>"],"mappings":";;AAoFA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,SAAS,QAAQ,cAAc,CAAC,CAAC;AAC1C,OAAOC,YAAY,MAAM,+BAA+B;AACxD,OAAOC,KAAK,MAAM,OAAO;;AAEzB;;;;;;;;;IANA;IAOAA,KAAK,CAACC,QAAQ,CAACC,OAAO,GAAG,2BAA2B;;IAEpD;IACA,MAAMC,YAAY,GAAGP,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMQ,WAAW,GAAGR,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMS,KAAK,GAAGT,GAAG,CAAC,EAAE,CAAC;;IAErB;IACAC,SAAS,CAAC,MAAM;MACd;MACAM,YAAY,CAACG,KAAK,GAAG,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC;MAC3DC,cAAc,CAAC,CAAC;MAChBC,QAAQ,CAAC,CAAC;IACZ,CAAC,CAAC;;IAEF;AACA;AACA;IACA,MAAMC,eAAe,GAAIN,KAAK,IAAK;MACjC,IAAI,CAACA,KAAK,EAAE,OAAO,EAAE;MACrB,IAAI,OAAOA,KAAK,KAAK,QAAQ,EAAE,OAAOA,KAAK;MAC3C,IAAIA,KAAK,YAAYC,IAAI,EAAE,OAAOD,KAAK,CAACE,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC;MACnE,OAAOI,MAAM,CAACP,KAAK,CAAC;IACtB,CAAC;IAED,MAAMI,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI,CAACP,YAAY,CAACG,KAAK,EAAE;MACzB,MAAMQ,SAAS,GAAGF,eAAe,CAACT,YAAY,CAACG,KAAK,CAAC;MACrD,IAAI;QACF,MAAMS,GAAG,GAAG,MAAMf,KAAK,CAACgB,GAAG,CAAC,eAAe,EAAE;UAC3CC,MAAM,EAAE;YAAEC,IAAI,EAAEJ;UAAU;QAC5B,CAAC,CAAC;QACFV,WAAW,CAACE,KAAK,GAAGS,GAAG,CAACI,IAAI,CAACA,IAAI,IAAI,EAAE;MACzC,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZ;QACAC,OAAO,CAACC,KAAK,CAAC,WAAW,EAAEF,GAAG,CAACG,QAAQ,EAAEJ,IAAI,IAAIC,GAAG,CAACI,OAAO,CAAC;QAC7D1B,SAAS,CAACwB,KAAK,CAAC,YAAY,CAAC,CAAC,CAAC;MACjC;IACF,CAAC;;IAED;AACA;AACA;IACA,MAAMG,gBAAgB,GAAG,MAAOC,OAAO,IAAK;MAC1C,IAAI,CAACA,OAAO,EAAE;MACd,IAAI;QACF,MAAM1B,KAAK,CAAC2B,MAAM,CAAC,iBAAiBD,OAAO,EAAE,CAAC;QAC9C;QACAtB,WAAW,CAACE,KAAK,GAAGF,WAAW,CAACE,KAAK,CAACsB,MAAM,CAACC,IAAI,IAAIA,IAAI,CAACC,EAAE,KAAKJ,OAAO,CAAC;QACzE5B,SAAS,CAACiC,OAAO,CAAC,QAAQ,CAAC;M